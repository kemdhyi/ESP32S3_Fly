# ============================================================
# CF-Drone 飞控 —— ESP-IDF 默认配置
# 目标芯片：ESP32-S3
# ============================================================

# ---- 目标芯片 ----
CONFIG_IDF_TARGET="esp32s3"

# ---- CPU 与调度 ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_UNICORE=n
# 供 `sys` 命令打印任务表（含 CPU 占用与核心归属）
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# ---- 看门狗 ----
# 飞控主循环在标定（ca/cr）期间会长时间占用 CPU，不能让任务看门狗打断。
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_INT_WDT=n

# ---- Flash 与分区表 ----
# 4MB 为 ESP32-S3 模组最常见的配置，兼容性最好。
# 若你的模组是 8MB/16MB，可在 menuconfig -> Serial Flasher Config 中调大。
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- NVS（参数持久化）----
CONFIG_NVS_ENCRYPTION=n

# ---- ADC 校准（电池电压精度依赖此项）----
CONFIG_ADC_CAL_EFUSE_TP_ENABLE=y
CONFIG_ADC_CAL_EFUSE_VREF_ENABLE=y
CONFIG_ADC_CAL_LUT_ENABLE=y

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_SO_RCVBUF=y

# ---- 温度传感器 ----
# 说明：温度传感器由 esp_driver_tsens 组件提供，其 Kconfig 位于组件内
# （CONFIG_TEMP_SENSOR_*）。这里不做强制设定，app/cli.cpp 的 `sys` 命令
# 会用 TEMPERATURE_SENSOR_CONFIG_DEFAULT 在运行时探测，
# 若芯片不支持则跳过温度显示，不影响其余功能。

# ---- 编译器 ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- CF-Drone 应用配置 ----
CONFIG_CFDRONE_WIFI_ENABLED=y
CONFIG_CFDRONE_WEB_RC_ENABLED=y
CONFIG_CFDRONE_MAVLINK_ENABLED=y
CONFIG_CFDRONE_CONSOLE_UART_NUM=0
CONFIG_CFDRONE_CONSOLE_BAUD=115200
CONFIG_CFDRONE_FC_TASK_CORE=1
CONFIG_CFDRONE_FC_TASK_PRIORITY=10
CONFIG_CFDRONE_FC_TASK_STACK=8192
CONFIG_CFDRONE_HTTP_TASK_CORE=0
CONFIG_CFDRONE_HTTP_PORT=80
CONFIG_CFDRONE_HTTP_REDIRECT_PORT=8080
CONFIG_CFDRONE_MAVLINK_SYS_ID=1
CONFIG_CFDRONE_MAVLINK_UDP_LOCAL_PORT=14550
CONFIG_CFDRONE_MAVLINK_UDP_REMOTE_PORT=14550
